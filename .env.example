# DeepSeek configuration for threadline-memory (example — no real key here).
# Copy to `.env` and fill in your own key, OR export these in your shell.
# The module runs fine WITHOUT any of these: with no key it falls back to the
# built-in RuleBasedProfileUpdateClient, and the test suite never touches the network.

# Your DeepSeek API key. Leave blank to disable the DeepSeek client.
DEEPSEEK_API_KEY=

# API base URL (OpenAI-compatible chat/completions endpoint).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model name used for profile-patch extraction.
DEEPSEEK_MODEL=deepseek-v4-flash
